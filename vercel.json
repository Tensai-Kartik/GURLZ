    },
    {
      "source": "/dashboard",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/coach",
      "destination": "/api/index"
    },
    {
      "source": "/coach/:path*",
      "destination": "/api/index"
