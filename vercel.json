      "destination": "/api/index"
    },
    {
      "source": "/symptoms/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/diary",
      "destination": "/api/index"
    },
    {
      "source": "/diary/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/meals",
      "destination": "/api/index"
    },
    {
      "source": "/meals/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/sleep",
      "destination": "/api/index"
    },
    {
      "source": "/sleep/:path*",
      "destination": "/api/index"
    },
    {
