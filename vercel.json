{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/(auth|cycles|symptoms|diary|meals|sleep|mood|hydration|ask-ai|chat|emergency|reminders|notes|sos|settings|dashboard|coach|funfacts|orders|health)(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
