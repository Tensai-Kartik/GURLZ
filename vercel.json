      "destination": "/api/index"
    },
    {
      "source": "/hydration/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/ask-ai",
      "destination": "/api/index"
    },
    {
      "source": "/chat",
      "destination": "/api/index"
    },
    {
      "source": "/chat/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/emergency",
      "destination": "/api/index"
    },
    {
      "source": "/emergency/:path*",
      "destination": "/api/index"
