// GURLZ Wellness AI Prisma Schema
// DB: Supabase PostgreSQL (primary — local + production)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  authId       String?  @unique @map("auth_id")
  name         String
  email        String   @unique
  dob          String?
  age          Int?
  settings     String?
  cycleLength  Int?     @default(28) @map("cycle_length")
  periodLength Int?     @default(5) @map("period_length")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  cycles            Cycle[]
  symptoms          Symptom[]
  hydrations        Hydration[]
  meals             Meal[]
  sleeps            Sleep[]
  moodLogs          MoodLog[]
  reminders         Reminder[]
  diaryEntries      Diary[]
  notes             Note[]
  emergencyContacts EmergencyContact[]
  sosEvents         SosEvent[]
  orders            Order[]
  mythViews         UserMythSeen[]
  chatThreads       ChatThread[]
  logs              Log[]

  @@map("users")
}

model Cycle {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  flowLevel String?   @map("flow_level")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cycles")
}

model Symptom {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime
  mood      String?
  painLevel Int?     @map("pain_level")
  cravings  String?
  symptoms  String?
  notes     String?
  voiceBlob String?  @map("voice_blob")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("symptoms")
}

model Hydration {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @default(now())
  amountMl  Int      @map("amount_ml")
  goalMl    Int      @default(2000) @map("goal_ml")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hydration")
}

model Meal {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           DateTime @default(now())
  mealType       String   @map("meal_type")
  description    String
  calories       Int?
  recommendation String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meals")
}

model Sleep {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  date        DateTime @default(now())
  hours       Float
  quality     String?
  bedtime     String?
  suggestions String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sleep")
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @default(now())
  mood      String
  intensity Int      @default(5)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mood_logs")
}

model Reminder {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  type              String
  message           String
  scheduleCron      String?   @map("schedule_cron")
  nextRun           DateTime? @map("next_run")
  enabled           Boolean   @default(true)
  ignoreCount       Int       @default(0) @map("ignore_count")
  adaptiveFrequency String?   @default("normal") @map("adaptive_frequency")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Diary {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  title            String
  contentEncrypted String?  @map("content_encrypted")
  tags             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diary")
}

model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  tags      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  phone        String
  relationship String?
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model SosEvent {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  timestamp        DateTime @default(now())
  location         String?
  contactsNotified String?  @map("contacts_notified")
  status           String   @default("pending")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sos_events")
}

model Order {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  items       String
  partner     String
  status      String   @default("pending")
  eta         Int?
  amountCents Int?    @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model MythFact {
  id        String   @id @default(uuid())
  myth      String
  fact      String
  category  String   @default("menstruation")
  createdAt DateTime @default(now()) @map("created_at")

  seenBy UserMythSeen[]

  @@map("myths_facts")
}

model UserMythSeen {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  mythId String   @map("myth_id")
  seenAt DateTime @default(now()) @map("seen_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  myth MythFact @relation(fields: [mythId], references: [id], onDelete: Cascade)

  @@unique([userId, mythId])
  @@map("user_myth_seen")
}

model ChatThread {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("New Conversation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Log {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  type      String
  payload   String
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("logs")
}
