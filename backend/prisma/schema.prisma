generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId            String?            @unique @map("auth_id")
  name              String
  email             String             @unique
  dob               String?
  age               Int?
  settings          String?            @default("{}")
  cycleLength       Int?               @default(28) @map("cycle_length")
  periodLength      Int?               @default(5) @map("period_length")
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chatThreads       ChatThread[]
  cycles            Cycle[]
  diaryEntries      Diary[]
  emergencyContacts EmergencyContact[]
  hydrations        Hydration[]
  logs              Log[]
  meals             Meal[]
  moodLogs          MoodLog[]
  notes             Note[]
  orders            Order[]
  reminders         Reminder[]
  sleeps            Sleep[]
  sosEvents         SosEvent[]
  symptoms          Symptom[]
  mythViews         UserMythSeen[]
  feedbacks         Feedback[]

  @@map("users")
}

model Cycle {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Timestamptz(6)
  endDate   DateTime? @map("end_date") @db.Timestamptz(6)
  flowLevel String?   @map("flow_level")
  notes     String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cycles")
}

model Symptom {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  date      DateTime  @db.Timestamptz(6)
  mood      String?
  painLevel Int?      @map("pain_level")
  cravings  Json?     @default("[]")
  symptoms  Json?     @default("[]")
  notes     String?
  voiceBlob String?   @map("voice_blob")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("symptoms")
}

model Hydration {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  date      DateTime  @default(now()) @db.Timestamptz(6)
  amountMl  Int       @map("amount_ml")
  goalMl    Int?      @default(2000) @map("goal_ml")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("hydration")
}

model Meal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  date           DateTime  @default(now()) @db.Timestamptz(6)
  mealType       String    @map("meal_type")
  description    String
  calories       Int?
  recommendation String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("meals")
}

model Sleep {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  date        DateTime  @default(now()) @db.Timestamptz(6)
  hours       Decimal   @db.Decimal(4, 1)
  quality     String?
  bedtime     String?
  suggestions String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sleep")
}

model MoodLog {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  date      DateTime  @default(now()) @db.Timestamptz(6)
  mood      String
  intensity Int?      @default(5)
  note      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("mood_logs")
}

model Reminder {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String
  message           String
  scheduleCron      String?   @map("schedule_cron")
  nextRun           DateTime? @map("next_run") @db.Timestamptz(6)
  enabled           Boolean?  @default(true)
  ignoreCount       Int?      @default(0) @map("ignore_count")
  adaptiveFrequency String?   @default("normal") @map("adaptive_frequency")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("reminders")
}

model Diary {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  contentEncrypted String?   @map("content_encrypted")
  tags             Json?     @default("[]")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("diary")
}

model Note {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  content   String
  tags      Json?     @default("[]")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notes")
}

model EmergencyContact {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String
  phone        String
  relationship String?
  priority     Int?      @default(0)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("emergency_contacts")
}

model SosEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  timestamp        DateTime? @default(now()) @db.Timestamptz(6)
  location         Json?
  contactsNotified Json?     @map("contacts_notified")
  status           String?   @default("pending")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sos_events")
}

model Order {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  items       Json
  partner     String
  status      String?   @default("pending")
  eta         Int?
  amountCents Int?      @map("amount_cents")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("orders")
}

model MythFact {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  myth      String
  fact      String
  category  String?        @default("menstruation")
  createdAt DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  seenBy    UserMythSeen[]

  @@map("myths_facts")
}

model UserMythSeen {
  id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String    @map("user_id") @db.Uuid
  mythId String    @map("myth_id") @db.Uuid
  seenAt DateTime? @default(now()) @map("seen_at") @db.Timestamptz(6)
  myth   MythFact  @relation(fields: [mythId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, mythId])
  @@map("user_myth_seen")
}

model ChatThread {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String        @default("New Conversation")
  createdAt DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId  String     @map("thread_id") @db.Uuid
  role      String
  content   String
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamptz(6)
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("chat_messages")
}

model Log {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  type      String
  payload   Json
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("logs")
}

model Feedback {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  userName    String    @map("user_name")
  userEmail   String    @map("user_email")
  type        String    @default("feedback")
  title       String
  description String
  status      String    @default("Pending")
  adminReply  String?   @map("admin_reply")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("feedbacks")
}
